# Supabase Postgres connection strings.
# Find both under Project Settings > Database > Connection string in the Supabase dashboard.

# Pooled connection (port 6543, PgBouncer) — used by the app at runtime.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"

# Direct connection (port 5432) — used by drizzle-kit to run migrations.
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"
